rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Games collection rules
    match /games/{gameId} {
      // Authenticated users can read games to browse/join
      allow read: if request.auth != null;
      
      // Only authenticated users can create games (host must match auth uid)
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.hostId
        && isValidGameCreation(request.resource.data);
      
      // Host, existing players, or a new player joining a waiting lobby may update
      allow update: if request.auth != null && (
        ((request.auth.uid == resource.data.hostId 
            || request.auth.uid in getPlayerIds(resource.data))
         && isValidGameUpdate(resource.data, request.resource.data))
        || isPlayerJoining(resource.data, request.resource.data)
      );
      
      // Host can delete their game; any authenticated client may delete stale
      // games eligible for the startup cleanup sweep (batch-safe across hosts).
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.hostId
        || isEligibleForClientCleanup(resource.data)
      );
    }
    
    // User rate limiting collection
    match /userLimits/{userId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
    }
  }
  
  // Helper functions
  function isValidGameCreation(data) {
    return data.keys().hasAll(['hostId', 'maxPlayers', 'status', 'createdAt', 'players'])
      && data.maxPlayers >= 2 
      && data.maxPlayers <= 6
      && data.status == 'waiting'
      && data.players.size() == 1
      && data.players[0].id == data.hostId;
  }
  
  function isValidGameUpdate(oldData, newData) {
    let allowedStatusTransitions = [
      ['waiting', 'playing'],
      ['waiting', 'cancelled'],
      ['playing', 'finished'],
      ['playing', 'cancelled']
    ];
    
    // Check if status transition is allowed
    let statusUnchanged = oldData.status == newData.status;
    let statusTransitionAllowed =
      [oldData.status, newData.status] in allowedStatusTransitions;
    let statusValid = statusUnchanged || statusTransitionAllowed;

    // Start/cancel are host-only; finished remains available to in-game sync.
    let hostOnlyTransition =
      (oldData.status == 'waiting' && newData.status == 'playing')
      || (oldData.status == 'waiting' && newData.status == 'cancelled')
      || (oldData.status == 'playing' && newData.status == 'cancelled');
    let hostAuthorizedForStatus = !hostOnlyTransition
      || request.auth.uid == oldData.hostId;
    
    // Don't allow changing host
    let hostUnchanged = oldData.hostId == newData.hostId;
    
    // Don't allow exceeding max players
    let playerCountValid = newData.players.size() <= newData.maxPlayers;

    // Field-level invariants for lobby/metadata fields.
    let maxPlayersUnchanged = oldData.maxPlayers == newData.maxPlayers;
    let createdAtUnchanged = oldData.createdAt == newData.createdAt;
    let completedAtValid = immutableOrSetOnTerminal(
      oldData, newData, 'completedAt'
    );
    let cleanupAtValid = immutableOrSetOnTerminal(
      oldData, newData, 'cleanupAt'
    );

    return statusValid
      && hostAuthorizedForStatus
      && hostUnchanged
      && playerCountValid
      && maxPlayersUnchanged
      && createdAtUnchanged
      && completedAtValid
      && cleanupAtValid
      && isApprovedGameStateUpdate(oldData, newData)
      && isPermittedPlayersUpdate(oldData, newData);
  }

  // completedAt/cleanupAt may be added when entering a terminal status; once
  // present they are immutable.
  function immutableOrSetOnTerminal(oldData, newData, field) {
    let isTerminal = newData.status == 'finished' || newData.status == 'cancelled';
    return !(field in oldData)
      ? (!(field in newData) || isTerminal)
      : (field in newData && oldData[field] == newData[field]);
  }

  function playersUnchanged(oldData, newData) {
    return oldData.players == newData.players;
  }

  // Supported players mutations: unchanged, self-leave, or same roster IDs
  // (display-name refresh on rejoin). Blocks arbitrary seat rewrites.
  function isPermittedPlayersUpdate(oldData, newData) {
    return playersUnchanged(oldData, newData)
      || isPlayerLeaving(oldData, newData)
      || isPlayerRosterIdentityPreserved(oldData, newData);
  }

  function isPlayerLeaving(oldData, newData) {
    return request.auth.uid in getPlayerIds(oldData)
      && !(request.auth.uid in getPlayerIds(newData))
      && newData.players.size() == oldData.players.size() - 1
      && getPlayerIds(oldData).hasAll(getPlayerIds(newData));
  }

  function isPlayerRosterIdentityPreserved(oldData, newData) {
    return newData.players.size() == oldData.players.size()
      && getPlayerIds(oldData).hasAll(getPlayerIds(newData))
      && getPlayerIds(newData).hasAll(getPlayerIds(oldData));
  }

  // gameState may change only on start, in-game sync/finish, or mid-game leave.
  function isApprovedGameStateUpdate(oldData, newData) {
    return gameStateUnchanged(oldData, newData)
      || isStartGameStateWrite(oldData, newData)
      || isInGameStateSync(oldData, newData)
      || isLeaveGameStateWrite(oldData, newData);
  }

  function isStartGameStateWrite(oldData, newData) {
    return oldData.status == 'waiting'
      && newData.status == 'playing'
      && playersUnchanged(oldData, newData)
      && newData.gameState != null;
  }

  function isInGameStateSync(oldData, newData) {
    return playersUnchanged(oldData, newData)
      && (
        (oldData.status == 'playing'
          && (newData.status == 'playing' || newData.status == 'finished'))
        || (oldData.status == 'finished' && newData.status == 'finished')
      );
  }

  function isLeaveGameStateWrite(oldData, newData) {
    return isPlayerLeaving(oldData, newData)
      && oldData.status == 'playing'
      && newData.status == 'playing';
  }

  function isPlayerJoining(oldData, newData) {
    return oldData.status == 'waiting'
      && oldData.hostId == newData.hostId
      && oldData.maxPlayers == newData.maxPlayers
      && oldData.status == newData.status
      && gameStateUnchanged(oldData, newData)
      && newData.players.size() == oldData.players.size() + 1
      && newData.players.size() <= newData.maxPlayers
      && getPlayerIds(newData).hasAll(getPlayerIds(oldData))
      && request.auth.uid in getPlayerIds(newData)
      && !(request.auth.uid in getPlayerIds(oldData));
  }

  function gameStateUnchanged(oldData, newData) {
    return oldData.get('gameState', null) == newData.get('gameState', null);
  }
  
  function getPlayerIds(gameData) {
    return gameData.players.map(player, player.id);
  }

  // Matches client cleanupExpiredGames / cleanupCompletedGames eligibility so
  // batch deletes of other hosts' stale docs are authorized.
  function isEligibleForClientCleanup(data) {
    let isTerminal = data.status == 'finished' || data.status == 'cancelled';
    let terminalReady = isTerminal && (
      ('cleanupAt' in data && data.cleanupAt <= request.time)
      || ('completedAt' in data
          && data.completedAt <= request.time - duration.value(1, 'h'))
    );
    let waitingExpired = data.status == 'waiting'
      && ('createdAt' in data)
      && data.createdAt <= request.time - duration.value(30, 'm');
    return terminalReady || waitingExpired;
  }
}
