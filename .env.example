# Copy to .env and fill from Firebase console or MCP firebase_get_sdk_config (web).
# DO NOT commit real values — .env is gitignored.
# Cloud Agents: run ./scripts/bootstrap_firebase_agent_env.sh to generate .env from injected vars.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_NUMBER=
FIREBASE_AUTH_EMAIL=

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.example.handFootGameFlutter
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_BUNDLE_ID=com.example.handFootGameFlutter

# OAuth CLI credentials (from Firebase MCP login + bootstrap script)
FIREBASE_CREDENTIALS_FILE=.firebase/oauth-credentials.json

# Cloud Agent: FIREBASE_TOOLS_CREDENTIALS_JSON is injected as env var (not written to .env).
# Bootstrap script materializes it to FIREBASE_CREDENTIALS_FILE and ~/.config/configstore/firebase-tools.json.

# Optional override for Firebase CLI OAuth client secret (scripts use firebase-tools default).
# FIREBASE_OAUTH_CLIENT_SECRET=

# Service account for headless Firestore analytics (preferred for Cloud Agents).
# Cloud Agents should provide hand-foot-flutter-firebase.json at the repo root.
# Create from GCP Console → Service Accounts → firebase-adminsdk → Add key → JSON
# Then base64-encode: base64 -w0 your-key.json  (Linux) or base64 -i your-key.json (macOS)
# FIREBASE_HAND_FOOT_SERVICE_ACCOUNT_B64=

# Optional local file path instead of B64 env var:
# FIREBASE_HAND_FOOT_SERVICE_ACCOUNT_FILE=hand-foot-flutter-firebase.json
